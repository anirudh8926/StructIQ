# StructIQ memory layer (Cognee) — the LLM's memory, NOT the verdict path.
# The deterministic compliance engine needs none of this; it only powers /ask.
#
# Strategy (see memory.py):
#   • Embeddings  -> ALWAYS local Ollama (nomic-embed-text). memory.py forces this so the
#     persisted vector store stays valid; you don't configure it here.
#   • LLM         -> cloud (the key below) as PRIMARY, with automatic fallback to local
#     Ollama (llama3.2:3b) on rate-limit / API error.
#
# Copy this to .env and add ONE cloud key. Leave it empty to run fully local (slower).

# --- Cloud LLM (primary). Provider is auto-detected from whichever key you set. ---
# NVIDIA NIM (OpenAI-compatible). nvapi-... keys are auto-routed to integrate.api.nvidia.com:
NVIDIA_API_KEY=nvapi-...
# LLM_MODEL=meta/llama-3.3-70b-instruct   # any model your NVIDIA key can access
#
# Or real OpenAI / Anthropic instead:
# OPENAI_API_KEY=sk-...                    # default model gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...             # default model claude-3-5-haiku
#
# Full manual override (any OpenAI-compatible endpoint):
# LLM_PROVIDER=openai
# LLM_MODEL=openai/meta/llama-3.3-70b-instruct
# LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-...

# --- Local fallback (Ollama). Defaults shown; normally no need to change. ---
# OLLAMA_BASE=http://localhost:11434
# STRUCTIQ_OLLAMA_LLM=llama3.2:3b
